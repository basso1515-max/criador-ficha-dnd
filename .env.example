# Server
HOST=127.0.0.1
PORT=8000

# Optional local-only override used by automated tests or isolated runs.
# SERVER_DATA_DIR=C:\path\to\temporary\server-data

# Vercel / Upstash Redis
# Use the Vercel integration or set these manually in the Vercel dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional defense-in-depth secret for new password hashes.
# Set only in production secrets. Rotating it requires users with peppered hashes
# to redefine passwords, so keep it stable and protected.
ACCOUNT_PASSWORD_PEPPER=

# Transactional account e-mails (password reset and account validation).
# Resend is used through its HTTP API.
RESEND_API_KEY=
ACCOUNT_EMAIL_FROM=
# Backward-compatible alias for ACCOUNT_EMAIL_FROM.
RESEND_FROM_EMAIL=
ACCOUNT_EMAIL_NAME=Sheetfy
# Optional public base URL for links in e-mails and OAuth callbacks.
# In production, set this to the canonical domain, for example:
# ACCOUNT_PUBLIC_BASE_URL=https://sheetfy.vercel.app
# Defaults to the request origin when empty.
ACCOUNT_PUBLIC_BASE_URL=
# Local/test helper only. Do not enable in production.
ACCOUNT_EMAIL_DEBUG_RESPONSE=

# OAuth social login. Configure the matching callback URL in Google and Facebook:
# Use Sheetfy as the public app/product name in Google and Facebook.
# http://127.0.0.1:8000/api/accounts/oauth/callback for local development
# https://sheetfy.vercel.app/api/accounts/oauth/callback for production
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Backward-compatible aliases; prefer GOOGLE_OAUTH_*.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
# Backward-compatible aliases; prefer FACEBOOK_OAUTH_*.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional; defaults to v24.0.
FACEBOOK_GRAPH_VERSION=

# Backward-compatible names also supported by the API.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional browser path for smoke tests when Chrome/Edge is not auto-detected.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Optional verbose cleanup logging for smoke tests.
DND_SMOKE_VERBOSE_CLEANUP=
