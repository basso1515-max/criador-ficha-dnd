# Server
HOST=127.0.0.1
PORT=8000

# Optional local-only override used by automated tests or isolated runs.
# SERVER_DATA_DIR=C:\path\to\temporary\server-data

# Vercel / Upstash Redis
# Use the Vercel integration or set these manually in the Vercel dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional defense-in-depth secret for new password hashes.
# Set only in production secrets. Rotating it requires users with peppered hashes
# to redefine passwords, so keep it stable and protected.
ACCOUNT_PASSWORD_PEPPER=

# OAuth social login. Configure the matching callback URL in each provider:
# http://127.0.0.1:8000/api/accounts/oauth/callback for local development
# https://your-domain.example/api/accounts/oauth/callback for production
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
# Optional; defaults to v24.0.
FACEBOOK_GRAPH_VERSION=

# Apple uses a Services ID as the client id and a Sign in with Apple private key.
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# Backward-compatible names also supported by the API.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional browser path for smoke tests when Chrome/Edge is not auto-detected.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
