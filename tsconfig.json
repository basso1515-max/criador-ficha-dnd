{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/account-storage.js",
    "src/character-migration.js",
    "src/user-area.js",
    "src/shared/character-schema.js",
    "src/editors/5e/spell-rules.js",
    "src/editors/5e/equipment-rules.js",
    "src/editors/5e/character-state.js",
    "src/editors/5e/feature-choice-rules.js",
    "src/editors/5e/main.js",
    "src/editors/2024/spell-rules.js",
    "src/editors/2024/equipment-rules.js",
    "src/editors/2024/character-state.js",
    "src/editors/2024/feature-choice-rules.js",
    "src/editors/2024/main.js",
    "scripts/serve.mjs"
  ]
}
