{
  "name": "sheetfy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sheetfy: gerador de ficha preenchível de D&D 5e em HTML/JS com exportação para PDF.",
  "scripts": {
    "check": "node scripts/check.mjs",
    "deploy:guardrails": "node scripts/verify-vercel-guardrails.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "perf:budget": "node scripts/performance-budget.mjs",
    "test:unit": "node --test \"scripts/unit/*.test.mjs\"",
    "test:randomization": "node scripts/randomization-regression.mjs",
    "smoke:dom": "node scripts/smoke-dom.mjs",
    "test:admin-layout": "node scripts/admin-layout-regression.mjs",
    "test:e2e:account": "node scripts/e2e-account.mjs",
    "test:e2e:share": "node scripts/e2e-character-share.mjs",
    "test:e2e": "npm run test:e2e:account && npm run test:e2e:share",
    "test:pdf:5e": "node scripts/e2e-pdf-export.mjs",
    "test:pdf:2024": "node scripts/e2e-pdf-export-2024.mjs",
    "test:pdf": "npm run test:pdf:5e && npm run test:pdf:2024",
    "test": "npm run deploy:guardrails && npm run check && npm run typecheck && npm run perf:budget && npm run test:unit && npm run test:randomization && npm run smoke:dom && npm run test:admin-layout && npm run test:e2e && npm run test:pdf",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "serve": "node scripts/serve.mjs",
    "serve:watchdog": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server-watchdog.ps1",
    "server:install-startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-server-startup.ps1",
    "server:uninstall-startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-server-startup.ps1",
    "server:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server-status.ps1",
    "start": "npm run serve"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.6.205"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "playwright-core": "^1.61.0",
    "typescript": "^6.0.3"
  }
}
